[Unit]
Description=FuelTaxPulse FastAPI Backend Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/fueltax/backend
Environment="PATH=/var/www/fueltax/venv/bin"
ExecStart=/var/www/fueltax/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
